# Desenvolvimento local. Copie para .env e carregue no terminal; a API não lê
# este arquivo automaticamente. As credenciais abaixo são as do Compose local.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/tractor_usage
FROZEN_MODEL_DIR=models/fendt314-hybrid-v2.0.1

# Login por número de trabalhador e senha, com sessão em cookie HttpOnly.
# Use 0 em HTTP local; use 1 somente quando o acesso ocorrer por HTTPS.
AUTH_COOKIE_SECURE=0

# Token separado para ingestão HTTP de janelas. Vazio desabilita essa ingestão;
# não impede login ou importação de CSV pela interface. Gere um valor aleatório
# para executar a API e run_api_replay.py, usando o mesmo valor nos dois processos.
# Não coloque tokens reais neste arquivo versionado.
INGEST_TOKEN=

# Proxy do frontend no desenvolvimento manual; a demo configura sua própria porta.
VITE_API_PROXY_TARGET=http://127.0.0.1:8000
